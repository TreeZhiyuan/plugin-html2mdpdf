{
  "manifest_version": 3,
  "name": "网页剪藏与 DOM 清理助手",
  "version": "1.0.0",
  "description": "交互式隐藏网页元素，框选导出区域，并导出 Markdown 或 PDF。",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "网页剪藏与 DOM 清理",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["libs/turndown.js", "libs/markitdown-html.js", "content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ]
}
